+void WaitVuXgkick(CMIPS* context, uint32 pc, uint32 relativeCycle)
+{
+	auto& state = context->m_State;
+	const uint32 elapsed = context->m_vuXgkickWait(context, pc, state.pipeTime + relativeCycle);
+	state.pipeTime += elapsed;
+	for(uint32 i = relativeCycle; i < 3; ++i)
+		state.pipeFmacWrite[i] = elapsed < 3 - i ? state.pipeFmacWrite[i + elapsed] : uint128{};
+}
+
+void ObserveVuMemory(CMIPS* context, uint32 pc, uint32 cycle, uint32 phase)
+{
+	if(context->m_vuMemoryObserver) context->m_vuMemoryObserver(context, pc, cycle, phase);
+}
+
+void EmitVuMemoryObserver(CMipsJitter* jitter, uint32 pc, uint32 relativeCycle, uint32 phase)
+{
+	jitter->PushCtx();
+	jitter->PushCst(pc);
+	jitter->PushRel(offsetof(CMIPS, m_State.pipeTime));
+	jitter->PushCst(relativeCycle);
+	jitter->Add();
+	jitter->PushCst(phase);
+	jitter->Call(reinterpret_cast<void*>(&ObserveVuMemory), 4, Jitter::CJitter::RETURN_VALUE_NONE);
+}
+}
 
