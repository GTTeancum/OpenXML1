+void SaturatePositiveFtoi(CMipsJitter* codeGen, uint8 source, uint32 fractionalBits)
+{
+	// Host truncation returns INT_MIN for either overflow direction. Positive
+	// raw float encodings at or above 2^(31-fractionalBits) instead saturate high.
+	codeGen->MD_PushCstExpandW(0x7FFFFFFF);
+	codeGen->Swap();
+	codeGen->MD_PushRel(offsetof(CMIPS, m_State.nCOP2[source]));
+	codeGen->MD_PushCstExpandW(0x4F000000 - (fractionalBits << 23) - 1);
+	codeGen->MD_CmpGtW();
+	codeGen->MD_BitSelect();
+}
