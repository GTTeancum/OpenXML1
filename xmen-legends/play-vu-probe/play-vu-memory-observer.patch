+uint32 ObserveVuStatus(CMIPS* context, uint32 opcode, uint32 cycle, uint32 value)
+{
+	return context->m_vuStatusObserver(context, opcode, cycle, value);
+}
+
+void EmitVuStatus(CMipsJitter* jitter, uint32 opcode, uint32 relativeCycle, size_t output = 0)
+{
+	jitter->PushCtx();
+	jitter->PushCst(opcode);
+	jitter->PushRel(offsetof(CMIPS, m_State.pipeTime));
+	jitter->PushCst(relativeCycle);
+	jitter->Add();
+	if(output) jitter->PushRel(output);
+	else jitter->PushCst(0);
+	jitter->Call(reinterpret_cast<void*>(&ObserveVuStatus), 4,
+	    output ? Jitter::CJitter::RETURN_VALUE_32 : Jitter::CJitter::RETURN_VALUE_NONE);
+	if(output) jitter->PullRel(output);
+}
+
+void ObserveVuEfu(CMIPS* context, uint32 opcode, uint32 cycle, uint32 event)
+{
+	context->m_vuEfuObserver(context, opcode, cycle, event);
+}
+
+void EmitVuEfu(CMipsJitter* jitter, uint32 opcode, uint32 relativeCycle)
+{
+	jitter->PushCtx();
+	jitter->PushCst(opcode);
+	jitter->PushRel(offsetof(CMIPS, m_State.pipeTime));
+	jitter->PushCst(relativeCycle);
+	jitter->Add();
+	jitter->PushCst(0);
+	jitter->Call(reinterpret_cast<void*>(&ObserveVuEfu), 4, Jitter::CJitter::RETURN_VALUE_NONE);
+}
+}
